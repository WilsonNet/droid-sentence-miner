{
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "description": "Marketing site and documentation for Droid Sentence Miner.",
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "GPL-3.0-only",
  "name": "droid-sentence-miner-site",
  "packageManager": "pnpm@12.15.0",
  "private": true,
  "scripts": {
    "build": "astro build",
    "check": "astro check && biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "check:lint": "biome check --error-on-warnings .",
    "check:types": "astro check",
    "dev": "astro dev",
    "format": "biome format --write .",
    "preview": "astro preview",
    "verify": "astro check && biome check --error-on-warnings . && astro build"
  },
  "type": "module",
  "version": "1.0.0"
}
